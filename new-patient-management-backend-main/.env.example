# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Auth — REQUIRED in every environment, min 32 chars. App refuses to start without it.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Redis — set this to enable caching (optional, app works without it)
# Upstash Redis (recommended for Vercel): redis://default:password@host.upstash.io:6379
# Redis Cloud / self-hosted:             redis://default:password@host:6379
REDIS_URL=

# App — use "development" locally; "production" is set automatically on Vercel
NODE_ENV=development
PORT=4500
DB_POOL_SIZE=10
DB_CONNECTION_TIMEOUT=10000

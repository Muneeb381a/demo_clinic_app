# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Auth — REQUIRED in every environment, min 32 chars. App refuses to start without it.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Redis — set this to enable caching (optional, app works without it)
# Upstash Redis (recommended for Vercel): redis://default:password@host.upstash.io:6379
# Redis Cloud / self-hosted:             redis://default:password@host:6379
REDIS_URL=

# App — use "development" locally; "production" is set automatically on Vercel
NODE_ENV=development
PORT=4500
DB_POOL_SIZE=10
DB_CONNECTION_TIMEOUT=10000

# Set to "true" when running behind a proxy/CDN (Vercel) so req.ip and rate
# limiting see the real client address.
TRUST_PROXY=false

# Optional: failed-login attempts allowed per IP per 15 min (default 10).
# LOGIN_RATE_MAX=10

# Optional: comma-separated extra allowed CORS origins (localhost and
# *.vercel.app are always allowed).
# ALLOWED_ORIGINS=https://clinic.example.com

# Logging: debug | info | warn | error (default info).
# LOG_LEVEL=info

# Sentry (optional) — error tracking is inert unless SENTRY_DSN is set.
SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0

# Base URL of the backend API.
# Local dev: leave blank — Vite proxy (vite.config.js) forwards /api to localhost:4500
# Production: set to the deployed backend origin (configured in Vercel project env, not here)
VITE_API_BASE_URL=

# Sentry (optional) — error tracking is inert unless this is set at build time.
VITE_SENTRY_DSN=
# VITE_SENTRY_TRACES_SAMPLE_RATE=0

# Per-clinic subdomain branding (optional) — inert unless set at build time.
# Set to your own domain once you own one and have wired wildcard DNS to it
# (e.g. "yourapp.com" with a "*.yourapp.com" CNAME/A record pointed at Vercel,
# and the wildcard domain added in the Vercel project's Domains settings).
# With this unset, greenvalley.yourapp.com etc. is just a normal generic
# login screen — nothing breaks, the feature simply doesn't activate.
# VITE_APP_ROOT_DOMAIN=yourapp.com
